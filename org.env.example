# org.env — per-machine settings, in one place. Copy to org.env (it is git-ignored) and fill in.
# A variable already set in your shell wins over this file, so a second person can use their own
# account for one command without editing it:  MEMBER_CONFIG_DIR=~/.claude-second scripts/member-launch.sh ...

# Claude Code config folder of the account members run as. Every member uses this one account.
# One account only? Use ~/.claude. More than one: create a folder per account and log in once:
#   CLAUDE_CONFIG_DIR=~/.claude-team claude   then /login, then exit
MEMBER_CONFIG_DIR=

# Where every worktree lives. Keep it outside .claude/worktrees/ (the app may clean that up).
WORKTREE_ROOT=~/worktrees

# Optional: model and permission mode for members (empty = Claude Code's default model / auto).
MEMBER_MODEL=
MEMBER_PERMISSION_MODE=
